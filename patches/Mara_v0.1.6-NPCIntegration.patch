+/**
+ * Mara works at the pet shop from 09:00 until 13:59 and is at home at all other times.
+ * Keep the schedule in one place so her shop, home, and encounter passages cannot drift apart.
+ * @returns {"shop" | "home"}
+ */
+function maraSchedule() {
+	return Time.hour >= 9 && Time.hour < 14 ? "shop" : "home";
+}
+window.maraSchedule = maraSchedule;
+
+/** Updates Mara's current location and relationship milestones for passages and UI. */
+function maraStatusCheck(mara = C.npc.Mara) {
+	const status = [];
+	if (V.mara?.metShop || V.mara?.metHouse) status.push("met");
+	if (mara.love >= 50) status.push("love");
+	if (mara.trust >= 50) status.push("trust");
+	if (V.mara?.romanceUnlocked) status.push("romance");
+	if (V.mara?.handlerRelationship) status.push("handler");
+	T.mara_location = maraSchedule();
+	return (T.maraStatus = status);
+}
+window.maraStatusCheck = maraStatusCheck;
 
