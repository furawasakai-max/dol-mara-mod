 /**
- * Mara works at the pet shop from 09:00 until 13:59 and is at home at all other times.
- * Keep the schedule in one place so her shop, home, and encounter passages cannot drift apart.
- * @returns {"shop" | "home"}
+ * Mara works at the pet shop from 09:00 to 13:59. If the player has met her, she may
+ * spend a randomly selected evening at Ocean Breeze between 17:00 and 18:59.
+ * The daily roll is saved so revisiting locations cannot reroll her availability.
+ * @returns {"shop" | "cafe" | "home"}
  */
 function maraSchedule() {
-	return Time.hour >= 9 && Time.hour < 14 ? "shop" : "home";
+	if (Time.hour >= 9 && Time.hour < 14) return "shop";
+
+	if (Time.hour >= 17 && Time.hour < 19 && (V.mara?.metShop || V.mara?.metHouse)) {
+		V.daily.mara ??= {};
+		if (V.daily.mara.cafeDeparted) return "home";
+		if (V.daily.mara.cafePresent === undefined) V.daily.mara.cafePresent = random(1, 100) <= 40;
+		if (V.daily.mara.cafePresent) return "cafe";
+	}
+	return "home";
 }
 window.maraSchedule = maraSchedule;
 
