+:: Mara Pet Housewear [widget]
+<<widget "maraPetHousewear">>
+	<<if $mara.petRulesEstablished and !$mara.petHouseDressed>>
+		/* Keep the player's existing outfit in a named storage location so it can be restored on leaving Mara's home. */
